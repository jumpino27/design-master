# Design Gen Local Configuration (Placeholders Only)
# Copy to .env if needed. Never commit real secrets.

# Optional: Custom local data directory for SQLite DB, uploads, outputs, and exports.
# Defaults to the OS application data directory (e.g., ~/Library/Application Support/design-gen on macOS).
# DESIGN_GEN_DATA_DIR=/path/to/design-gen-data

# Optional: OpenRouter API Key fallback when OS keyring is unavailable.
# Prefer storing the key via the Design Gen Setup UI (uses OS-native keyring).
# OPENROUTER_API_KEY=sk-or-v1-placeholder-do-not-commit

# Optional: Server bind address (defaults to loopback 127.0.0.1:4318)
# DESIGN_GEN_BIND_ADDR=127.0.0.1:4318

# Optional: Path to static exported frontend directory for production serving
# DESIGN_GEN_STATIC_DIR=./web/out

# Optional: Enable deterministic test fixture adapter for automated E2E tests (0 or 1)
# DESIGN_GEN_TEST_ADAPTER=0
