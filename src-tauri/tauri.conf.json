{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Design Master",
  "version": "1.1.2",
  "identifier": "com.designmaster.workbench",
  "build": {
    "frontendDist": "bootstrap-dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "deb",
      "rpm",
      "appimage",
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../web/out/": "web-out/",
      "../prompts/v1/": "prompts/v1/"
    },
    "category": "DeveloperTool",
    "shortDescription": "Design Master (DM) \u2014 AI UI, Multi-Page WebApp, Game HUD & Transparent Asset Workbench",
    "longDescription": "Design Master (DM) is a dark-mode local AI design workbench that generates brand-consistent interfaces, extracts transparent assets 1:1 in the same tab, and produces human-language coding-agent handoff prompts.",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ],
        "postInstallScript": "linux-postinst.sh"
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
